# XAI_API_KEY: Required for grok-4.5 xAI Responses API calls.
# Generate your key at https://console.x.ai
# Set via terminal: export XAI_API_KEY="xai-..."
XAI_API_KEY="xai-..."

# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
